# Copy this file to a new file named .env (in this same folder) and put your own values in it.
# Never share or upload your real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DJANGO_SECRET_KEY=generate-your-own-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Only needed on a live website (Lesson 17), e.g. https://*.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
